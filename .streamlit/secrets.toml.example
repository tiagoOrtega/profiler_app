# Copy this file to .streamlit/secrets.toml and fill in your credentials.
# NEVER commit secrets.toml to git.

[connections.snowflake]
account   = "orgname-accountname"   # e.g. "myorg-myaccount" or "abc12345.us-east-1"
user      = "your_user"
password  = "your_password"
warehouse = "COMPUTE_WH"
database  = "SAMPLE_DW"
schema    = "RETAIL"
role      = "SYSADMIN"
